generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  parent              Parent?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Beneficiary {
  id                  String    @id @default(uuid())
  name                String
  birthday            DateTime  @db.Date
  rg                  Int
  cpf                 Int       @unique
  school              String
  period              String
  health_info         health_info?
  parent              ParentBenificiary[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model health_info {
  id                  String  @id @default(uuid())
  beneficiary_id      String  @unique
  health_problem      String?
  medical_tratament   String?
  allergy             String?
  previous_illnesses  String?
  beneficiary         Beneficiary @relation(fields: [beneficiary_id], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Parent {
  id                  String        @id @default(uuid())
  user_id             String?       @unique
  name                String
  cpf                 Int           @unique
  contact             String
  email               String        @unique
  profession          String?
  educational_level   String?
  comertial_address   String?
  salary              Float?
  user                User?         @relation(fields: [user_id], references: [id])
  beneficiary         ParentBenificiary[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model ParentBenificiary {
  id                String      @id @default(uuid())
  beneficiary_id    String      
  parent_id         String      @unique
  relationshipType  Int

  beneficiary       Beneficiary @relation(fields: [beneficiary_id], references: [id])
  parent            Parent      @relation(fields: [parent_id], references: [id])

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}